		queryGroup: Fatos
		source = ```
				let
				    Fonte = Table.Combine({F_Projetos_Principais, F_Projetos_Backlog, F_Projetos_Pausados,F_Projetos_Priorizados}),
				    #"Mod. Tipo Col. Datas" = Table.TransformColumnTypes(Fonte,{{"Project Created At", type datetime}, {"Project Modified At", type datetime}, {"Project Due On", type date}, {"Project Start On", type date}, {"Task Created At", type datetime}, {"Task Completed At", type datetime}, {"Task Start On", type datetime}, {"Task Due At", type datetime}, {" Prazo para Entrega ", type date}}),
				    #"Adc. Status Name" = Table.AddColumn(#"Mod. Tipo Col. Datas", "Status Name", each 
				        if [Project Current Status Color] = "green" then "Em Dia" 
				        else if [Project Current Status Color] = "blue" then "Em Espera" 
				        else if [Project Current Status Color] = "red" then "Em Atraso" 
				        else if [Project Current Status Color] = "yellow" then "Em Risco" 
				        else if [Project Current Status Color] = "complete" then "Concluido" 
				        else "Sem atualização recente"),
				    #"Adc. Link Projeto" = Table.AddColumn(#"Adc. Status Name", "ProjectLink", each Text.Combine({"https://app.asana.com/0/", Text.From([Project Id]), "/", Text.From([Project Id])})),
				    #"Adc. Link Tarefa" = Table.AddColumn(#"Adc. Link Projeto", "TaskLink", each Text.Combine({"https://app.asana.com/0/", Text.From([Project Id]), "/", Text.From([Task Id])})),
				    #"Adc. Equipe STI" = Table.AddColumn(#"Adc. Link Tarefa", "GRUPO ANALISTAS TASKS", each 
				/*Geraldo Batista*/                         if [Task Assignee Id] = 1201822071972279 then "PMO" else
