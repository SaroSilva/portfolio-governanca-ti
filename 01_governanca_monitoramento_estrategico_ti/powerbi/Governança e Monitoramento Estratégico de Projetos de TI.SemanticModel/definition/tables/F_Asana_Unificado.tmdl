	column '5. Status Text Formatado' = ```
			
			VAR s0 = 'F_Asana_Unificado'[Project Current Status Text]
			VAR s1 = SUBSTITUTE(s0, "Resumo:", "RESUMO:" & UNICHAR(10))
			VAR s2 = SUBSTITUTE(s1, "Próximos passos", UNICHAR(10) & "PRÓXIMOS PASSOS:" & UNICHAR(10))
			VAR s3 = SUBSTITUTE(s2, "Resumo Executivo", UNICHAR(10) & "RESUMO EXECUTIVO:" & UNICHAR(10))
			VAR s4 = SUBSTITUTE(s3, "Pontos principais:", UNICHAR(10) & "PONTOS PRINCIPAIS:" & UNICHAR(10))
			VAR s5 = SUBSTITUTE(s4, "Tarefas Concluídas", UNICHAR(10) & "TAREFAS CONCLUÍDAS:" & UNICHAR(10))
			VAR s6 = SUBSTITUTE(s5, "Tarefas em Andamento", UNICHAR(10) & "TAREFAS EM ANDAMENTO:" & UNICHAR(10))
			VAR s7 = SUBSTITUTE(s6, "Tarefas Futuras", UNICHAR(10) & "TAREFAS FUTURAS:" & UNICHAR(10))
			VAR s8 = SUBSTITUTE(s7, "Próximos Passos", UNICHAR(10) & "PRÓXIMOS PASSOS:" & UNICHAR(10))
			RETURN s8
			
			
			```
		lineageTag: e4cf43d9-377b-4c38-9674-8d384204724f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

