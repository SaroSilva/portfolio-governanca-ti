	partition 'F_Tasks - Diário PMO' = m
		mode: import
		queryGroup: Fatos
		source = ```
				let
				    Fonte = Asana.Tables("https://app.asana.com/0/1206788568863443/1206788568863443"),
				    Tasks1 = Fonte{[Name="Tasks"]}[Data],
				    #"Custom Fields Expandido" = Table.ExpandListColumn(Tasks1, "Custom Fields"),
				    #"Custom Fields Expandido1" = Table.ExpandRecordColumn(#"Custom Fields Expandido", "Custom Fields", {"name", "value"}, {"Custom Fields.name", "Custom Fields.value"}),
				    #"Remover Dados Nulos" = Table.SelectRows(#"Custom Fields Expandido1", each [Custom Fields.name] <> null and [Custom Fields.name] <> ""),
				    #"Manter Col. Relacionadas aos Projetos e Portifolios" = Table.SelectColumns(#"Remover Dados Nulos",{"Custom Fields.name", "Custom Fields.value", "Project Current Status Color", "Project Current Status Text", "Project Current Status Posted On", "Project Current Status Posted By", "Project Data Archived", "Project Id", "Project Color", "Project Created At", "Project Modified At", "Project Name", "Project Notes", "Project Owner Name", "Project Public", "Project Due On", "Project Start On", "Workspace Name", "Team Name","Task Id", "Task Name", "Task Section Id", "Task Section Name", "Task Assignee Id", "Task Assignee Name", "Task Completed", "Task Created At", "Task Completed At", "Task Start On", "Task Due At"}),
				    #"Remover Dados Nulos 2" = Table.SelectRows(#"Manter Col. Relacionadas aos Projetos e Portifolios", each [Custom Fields.name] <> null and [Custom Fields.name] <> ""),
				    #"Pivot Categorias Tarefas" = Table.Pivot(#"Remover Dados Nulos 2", List.Distinct(#"Remover Dados Nulos 2"[#"Custom Fields.name"]), "Custom Fields.name", "Custom Fields.value"),
				    #"Adc. Col. sobre Fonte dos Dados" = Table.AddColumn(#"Pivot Categorias Tarefas", "Fonte", each "Interno PMO"),
				    #"Ajuste do Tipo Col." = Table.TransformColumnTypes(#"Adc. Col. sobre Fonte dos Dados",{{"Project Current Status Color", type any}, {"Project Current Status Text", type any}, {"Project Current Status Posted On", type any}, {"Project Current Status Posted By", type any}, {"Project Data Archived", type logical}, {"Project Id", Int64.Type}, {"Project Color", type text}, {"Project Created At", type datetime}, {"Project Modified At", type datetime}, {"Project Name", type text}, {"Project Notes", type text}, {"Project Owner Name", type text}, {"Project Public", type logical}, {"Project Due On", type any}, {"Project Start On", type any}, {"Workspace Name", type text}, {"Team Name", type text}, {"Task Id", Int64.Type}, {"Task Name", type text}, {"Task Section Id", Int64.Type}, {"Task Section Name", type text}, {"Task Assignee Id", Int64.Type}, {"Task Assignee Name", type text}, {"Task Completed", type logical}, {"Task Created At", type datetime}, {"Task Completed At", type datetime}, {"Task Start On", type date}, {"Task Due At", type datetime}, {"Status da Tarefa", type text}, {"Prioridade", type text}, {"Classificação", type any}, {"Setor | Área Demandante", type any}, {"Estimated time", Int64.Type}, {"Co-Responsável-gId", type any}, {"Co-Responsável-name", type any}, {"Fonte", type text}}),
				    #"Adc. Status Name" = Table.AddColumn(#"Ajuste do Tipo Col.","Status Name", each 
				        if [Project Current Status Color] = "green" then "Em Dia" 
				        else if [Project Current Status Color] = "blue" then "Em Espera" 
				        else if [Project Current Status Color] = "red" then "Em Atraso" 
				        else if [Project Current Status Color] = "yellow" then "Em Risco" 
				        else if [Project Current Status Color] = "complete" then "Concluido" 
				        else "Sem atualização recente"),
				    #"Adc. Link Projeto" = Table.AddColumn(#"Adc. Status Name", "ProjectLink", each Text.Combine({"https://app.asana.com/0/", Text.From([Project Id]), "/", Text.From([Project Id])})),
				    #"Adc. Link Tarefa" = Table.AddColumn(#"Adc. Link Projeto", "TaskLink", each Text.Combine({"https://app.asana.com/0/", Text.From([Project Id]), "/", Text.From([Task Id])})),
				    #"Adc. Equipe STI" = Table.AddColumn(#"Adc. Link Tarefa", "GRUPO ANALISTAS TASKS", each 
				/*Geraldo Batista*/                         if [Task Assignee Id] = 1201822071972279 then "PMO" else
				/*Edilson Costa*/                           if [Task Assignee Id] = 1205233743550527 then "PMO" else
