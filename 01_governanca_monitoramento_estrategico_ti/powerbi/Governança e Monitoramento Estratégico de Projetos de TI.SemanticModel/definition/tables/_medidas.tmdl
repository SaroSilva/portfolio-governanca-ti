table _medidas
	lineageTag: 5d13a869-5315-415d-99e6-d47769ea0e90

	measure '2. Total Task Planejadas' =
			
			/*Criado por: Tiago*/
			/*Aprovado por: */
			/*Revisado por: Massáro Júnio em 13/04/24*/
			    DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id])+0
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 35e23078-8743-427e-9be5-125421395ac3

	measure '2.1 Total Task Concluidas' =
			
			/*Criado por: Tiago*/
			/*Aprovado por: */
			/*Revisado por: Massáro Júnio em 13/04/24*/
			    CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id]),'F_Asana_Unificado'[DH_CONCLUSÃO] <> BLANK())+0
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 82a5da97-e42e-47e5-ac07-618049ddfad0

	measure '2.2 Total Task Reagendadas' =
			
			VAR REAGENDADAS = [2. Total Task Planejadas] - [2.1 Total Task Concluidas]
			RETURN
			IF (REAGENDADAS > 0, REAGENDADAS,REAGENDADAS *-1)
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: afd08066-8859-4829-a866-d11bab9e22ac

	measure '#Meta dos Projetos' = 0.85
		lineageTag: 3aad06f7-abf7-49a1-9972-ef5e8c4b6486

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4. Taxa de Anadamento dos Projetos' = ```
			
			VAR Total_Tarefas =
			    CALCULATE (
			        DISTINCTCOUNTNOBLANK ( 'F_Asana_Unificado'[Task Id] ),
			        F_Asana_Unificado[Portifólio] = "Pipeline",
			        ALLEXCEPT ( 'F_Asana_Unificado', 'F_Asana_Unificado'[Project Name] ) 
			    )
			VAR Tarefas_Concluidas =
			    CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id]), F_Asana_Unificado[Portifólio] = "Pipeline", 'F_Asana_Unificado'[DH_CONCLUSÃO] <> BLANK())
			RETURN
			DIVIDE ( Tarefas_Concluidas, Total_Tarefas, 0 )
			
			```
		displayFolder: Tarefas
		lineageTag: 96bc6e71-7fac-4361-82d0-8836077689c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4.1 vBarra Progresso Realizados Horizontal' = ```
			
			VAR vValor = [3. Tx(%) Task no Prazo] + 0
			VAR vValor_formatado = FORMAT(vValor, "0.00%")
			VAR vMeta = [#Meta dos Projetos]
			VAR vMeta_formatado = FORMAT(vMeta, "0%")
			
			-- FORMATAÇÕES
			VAR vFonte = "Segoe UI"
			VAR vRotulo_categoria_texto = "Tasks Entregues no Prazo: "
			VAR vRotulo_categoria_cor = "#000000"
			VAR vRotulo_categoria_tam = 20
			VAR vRotulo_categoria_peso = "bold"
			
			VAR vRotulo_dados_cor =
			    SWITCH(
			        TRUE(),
			        vValor >= 0.80, "#047857",
			        vValor >= 0.60 && vValor < 0.80, "#047077",
			        vValor >= 0.40 && vValor < 0.60, "#BCC510",
			        vValor >= 0.20 && vValor < 0.40, "#FFA513",
			        vValor >= 0.01 && vValor < 0.20, "#FC0400",
			        "#B3B3B3"
			    )
			
			VAR vRotulo_dados_tam = 21
			VAR vRotulo_dados_peso = 400
			
			VAR vBarra_altura = 21
			VAR vBarra_comprimento = 150
			VAR vBarra_progresso_cor = vRotulo_dados_cor
			VAR vBarra_fundo_cor = "#d1d5db"
			VAR vBarra_fundo_opacidade = 5
			VAR vLinha_meta_larg = 3
			VAR vLinha_meta_cor = "#3f3f3f"
			
			-- Layout geral
			VAR vComprimento_Layout = 400
			VAR vAltura_Layout = 70
			VAR vOffsetX = 110
			VAR vOffsetY = -10
			VAR vLargura = 260
			VAR vAltura = 90
			
			-- Cálculos da barra
			VAR vComprimento_Progresso = MIN(vBarra_comprimento, MAX(0, ROUND(vBarra_comprimento * vValor, 0)))
			VAR vPosicao_Meta = MIN(vBarra_comprimento, MAX(0, ROUND(vBarra_comprimento * vMeta, 0)))
			
			-- Posição da barra
			VAR vPosicaoBarraX = 260
			VAR vPosicaoBarraY = 13
			
			RETURN
			"data:image/svg+xml;utf8,<svg width='" & vComprimento_Layout & "' height='" & vAltura_Layout &
			"' viewBox='" & vOffsetX & " " & vOffsetY & " " & vLargura & " " & vAltura &
			"' xmlns='http://www.w3.org/2000/svg'>
			
			<text fill='" & vRotulo_categoria_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_categoria_tam & "' font-weight='" & vRotulo_categoria_peso & "'>
			    <tspan x='0' y='28'>" & vRotulo_categoria_texto & "</tspan>
			</text>
			
			<rect x='" & vPosicaoBarraX & "' y='" & vPosicaoBarraY & "' width='" & vBarra_comprimento & "' height='" & vBarra_altura & "' fill='" & vBarra_fundo_cor & "' opacity='0." & vBarra_fundo_opacidade & "' />
			<rect x='" & vPosicaoBarraX & "' y='" & vPosicaoBarraY & "' width='" & vComprimento_Progresso & "' height='" & vBarra_altura & "' fill='" & vBarra_progresso_cor & "' />
			
			<text fill='" & vRotulo_dados_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_dados_tam & "' font-weight='" & vRotulo_dados_peso & "'>
			    <tspan x='" & (vPosicaoBarraX + vBarra_comprimento + 10) & "' y='" & (vPosicaoBarraY + vBarra_altura - 2) & "'>" & vValor_formatado & "</tspan>
			</text>
			
			<!-- Linha da meta -->
			<rect x='" & (vPosicaoBarraX + vPosicao_Meta) & "' y='" & (vPosicaoBarraY - 5) & "' width='" & vLinha_meta_larg & "' height='" & (vBarra_altura + 10) & "' fill='" & vLinha_meta_cor & "' />
			
			<!-- Texto da meta abaixo do traço -->
			<text fill='" & vLinha_meta_cor & "' font-family='" & vFonte & "' font-size='16' font-weight='bold' text-anchor='middle'>
			    <tspan x='" & (vPosicaoBarraX + vPosicao_Meta + (vLinha_meta_larg * 2)) & "' y='" & (vPosicaoBarraY + vBarra_altura - 30) & "'>" & (vMeta_formatado) & "</tspan>
			</text>
			
			</svg>"
			
			```
		displayFolder: Tarefas
		lineageTag: 243fc260-0ffb-420d-9fcf-629cd6902dcf

	measure '3. Tx(%) Task no Prazo' =
			
			/*
			VAR PRAZO =CALCULATE(DISTINCTCOUNTNOBLANK(F_Tasks[Task Id]),F_Tasks[MED_BASE - TAG TASK MENSAL] = "NO PRAZO" && F_Tasks[DT_Conclusão_Task] <> BLANK())
			    RETURN
			    DIVIDE(PRAZO,[MED_BASE - TOTAL TASK PLANEJADAS],0)+0
			*/
			VAR PRAZO =CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id]),'F_Asana_Unificado'[Classificacao Task Mensal] = "NO PRAZO" && 'F_Asana_Unificado'[DT_Conclusão_Task] <> BLANK())
			    RETURN
			    DIVIDE(PRAZO,[2. Total Task Planejadas],0)+0
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Tarefas
		lineageTag: 5fe1afbd-d2dc-4c0a-afd0-4bf513363994

	measure '2.3 Total Task Fechadas no Prazo' = ```
			
			    VAR PRAZO = CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id]),'F_Asana_Unificado'[Classificacao Task Mensal] = "NO PRAZO" && 'F_Asana_Unificado'[DT_Conclusão_Task] <> BLANK())
			    RETURN
			    PRAZO+0
			```
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 3f7d1291-3739-435b-8556-afa0497bb3c5

	measure '3.1 Tx(%) Task Após o Prazo' = ```
			
			    VAR CONCLUSAO = CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id]),'F_Asana_Unificado'[Classificacao Task Mensal] = "CONCLUIDO COM ATRASO")
			    RETURN
			    DIVIDE(CONCLUSAO,[2. Total Task Planejadas],0)+0
			```
		displayFolder: Tarefas
		lineageTag: 5d6d7a52-6ea3-4efe-b3db-0bf6369d5bea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '3.3 - Txt Tx no Prazo' =
			
			IF([2.3 Total Task Fechadas no Prazo] > 1000, FORMAT([2.3 Total Task Fechadas no Prazo],"#0,000"),[2.3 Total Task Fechadas no Prazo]) & " ("& FORMAT([3. Tx(%) Task no Prazo],"0%") &")"
		displayFolder: Tarefas
		lineageTag: 304158fa-1224-4f93-9214-92e113a73213

	measure '3.4 - Txt Tx no com atraso' =
			
			IF([2.4 Total Task Fechadas após o Prazo] > 1000, FORMAT([2.4 Total Task Fechadas após o Prazo],"#0,000"),[2.4 Total Task Fechadas após o Prazo])  & " ("& FORMAT([3.1 Tx(%) Task Após o Prazo],"0%") &")"
		displayFolder: Tarefas
		lineageTag: fdebfc7f-cf52-441f-83be-685f8df3d95f

	measure '2.4 Total Task Fechadas após o Prazo' = ```
			
			    VAR PRAZO = CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Task Id]),'F_Asana_Unificado'[Classificacao Task Mensal] = "CONCLUIDO COM ATRASO" && 'F_Asana_Unificado'[DT_Conclusão_Task] <> BLANK())
			    RETURN
			    PRAZO+0
			```
		formatString: 0
		displayFolder: Tarefas
		lineageTag: d3541619-e2f9-4199-948a-97236e97b4fa

	measure '1 Total Projeto Ativos' = ```
			
			    DISTINCTCOUNT('F_Asana_Unificado'[Project Id])+0
			```
		formatString: 0
		displayFolder: Projetos
		lineageTag: 87ad3670-7429-4bda-bbe7-8453b169ec89

	measure '1.1 Total Projetos Priorizados' =
			
			VAR priori = CALCULATE(
			    DISTINCTCOUNT('F_Asana_Unificado'[Project Id])
			)+0
			RETURN
			IF(priori > 1, "Projetos: "&priori, "Projeto: "&priori)
		displayFolder: Projetos
		lineageTag: e0086be9-33b4-4b25-9c1b-ceaa0a34bea5

	measure '4.2 vBarra Progresso Andamento das Atividades Horizontal' = ```
			
			VAR vValor = [4. Taxa de Anadamento dos Projetos] + 0
			VAR vValor_formatado = FORMAT(vValor, "0.0%")
			VAR vMeta = [#Meta dos Projetos]
			VAR vMeta_formatado = FORMAT(vMeta, "0%")
			
			-- FORMATAÇÕES
			VAR vFonte = "Segoe UI"
			VAR vRotulo_categoria_texto = "Progresso das Tarefas: "
			VAR vRotulo_categoria_cor = "#000000"
			VAR vRotulo_categoria_tam = 20
			VAR vRotulo_categoria_peso = "bold"
			
			VAR vRotulo_dados_cor =
			    SWITCH(
			        TRUE(),
			        vValor >= 0.80, "#047857",
			        vValor >= 0.60 && vValor < 0.80, "#047077",
			        vValor >= 0.40 && vValor < 0.60, "#BCC510",
			        vValor >= 0.20 && vValor < 0.40, "#FFA513",
			        vValor >= 0.01 && vValor < 0.20, "#FC0400",
			        "#B3B3B3"
			    )
			
			VAR vRotulo_dados_tam = 21
			VAR vRotulo_dados_peso = 500
			
			VAR vBarra_altura = 21
			VAR vBarra_comprimento = 150
			VAR vBarra_progresso_cor = vRotulo_dados_cor
			VAR vBarra_fundo_cor = "#d1d5db"
			VAR vBarra_fundo_opacidade = 5
			VAR vLinha_meta_larg = 3
			VAR vLinha_meta_cor = "#3f3f3f"
			
			-- Layout geral
			VAR vComprimento_Layout = 500
			VAR vAltura_Layout = 80
			VAR vOffsetX = 110
			VAR vOffsetY = -10
			VAR vLargura = 180
			VAR vAltura = 90
			
			-- Cálculos da barra
			VAR vComprimento_Progresso = MIN(vBarra_comprimento, MAX(0, ROUND(vBarra_comprimento * vValor, 0)))
			VAR vPosicao_Meta = MIN(vBarra_comprimento, MAX(0, ROUND(vBarra_comprimento * vMeta, 0)))
			
			-- Posição da barra
			VAR vPosicaoBarraX = 220
			VAR vPosicaoBarraY = 13
			
			RETURN
			"data:image/svg+xml;utf8,<svg width='" & vComprimento_Layout & "' height='" & vAltura_Layout &
			"' viewBox='" & vOffsetX & " " & vOffsetY & " " & vLargura & " " & vAltura &
			"' xmlns='http://www.w3.org/2000/svg'>
			
			<text fill='" & vRotulo_categoria_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_categoria_tam & "' font-weight='" & vRotulo_categoria_peso & "'>
			    <tspan x='0' y='28'>" & vRotulo_categoria_texto & "</tspan>
			</text>
			
			<rect x='" & vPosicaoBarraX & "' y='" & vPosicaoBarraY & "' width='" & vBarra_comprimento & "' height='" & vBarra_altura & "' fill='" & vBarra_fundo_cor & "' opacity='0." & vBarra_fundo_opacidade & "' />
			<rect x='" & vPosicaoBarraX & "' y='" & vPosicaoBarraY & "' width='" & vComprimento_Progresso & "' height='" & vBarra_altura & "' fill='" & vBarra_progresso_cor & "' />
			
			<text fill='" & vRotulo_dados_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_dados_tam & "' font-weight='" & vRotulo_dados_peso & "'>
			    <tspan x='" & (vPosicaoBarraX + vBarra_comprimento + 10) & "' y='" & (vPosicaoBarraY + vBarra_altura - 2) & "'>" & vValor_formatado & "</tspan>
			</text>
			
			<!-- Linha da meta -->
			<rect x='" & (vPosicaoBarraX + vPosicao_Meta) & "' y='" & (vPosicaoBarraY - 5) & "' width='" & vLinha_meta_larg & "' height='" & (vBarra_altura + 10) & "' fill='" & vLinha_meta_cor & "' />
			
			<!-- Texto da meta abaixo do traço -->
			<text fill='" & vLinha_meta_cor & "' font-family='" & vFonte & "' font-size='15' font-weight='bold' text-anchor='middle'>
			    <tspan x='" & (vPosicaoBarraX + vPosicao_Meta + (vLinha_meta_larg * 2)) & "' y='" & (vPosicaoBarraY + vBarra_altura - 30) & "'>" & (vMeta_formatado) & "</tspan>
			</text>
			
			</svg>"
			
