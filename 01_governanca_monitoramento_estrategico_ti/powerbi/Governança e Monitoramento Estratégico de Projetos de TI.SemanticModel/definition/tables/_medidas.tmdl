	measure '7.2 Matriz Risco - Solução no Prazo' = ```
			
			    VAR DENTRO_MES = 
			    CALCULATE(
			       DISTINCTCOUNT('STI - PMO | Matriz de Riscos'[ID]),
			        /*USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),*/
			        //'STI - PMO | Matriz de Riscos'[Data da Resolução] <> BLANK(),
			        USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),
			        //  MONTH('STI - PMO | Matriz de Riscos'[Prazo para Resolução]) = MONTH('STI - PMO | Matriz de Riscos'[Data da Resolução])
			        'STI - PMO | Matriz de Riscos'[Risco Resolvido no Prazo] = "SIM"
			        )
			    VAR ANTECIPADOS = 
			    CALCULATE(
			       DISTINCTCOUNT('STI - PMO | Matriz de Riscos'[ID]),
			        /*USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),*/
			        //'STI - PMO | Matriz de Riscos'[Data da Resolução] <> BLANK(),
			        //USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),
			         MONTH('STI - PMO | Matriz de Riscos'[Prazo para Resolução]) > MONTH('STI - PMO | Matriz de Riscos'[Data da Resolução])
			        )
			        RETURN
			        DENTRO_MES
			```
		formatString: 0
		displayFolder: Matriz Risco - Lists
		lineageTag: 112aefc6-2e0e-4f72-9d81-8bc4f46ecb22

	measure '7.3 Matriz Risco - com prazo' = ```
			
