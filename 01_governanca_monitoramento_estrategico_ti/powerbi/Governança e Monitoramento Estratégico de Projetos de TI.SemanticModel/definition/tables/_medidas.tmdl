	measure '8.1 Matriz Risco Resolvidos Fora do Prazo' = ```
			
			    VAR prazo = 
			    CALCULATE(
			        DISTINCTCOUNT('STI - PMO | Matriz de Riscos'[ID]),
			        /*USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Prazo para Resolução]),*/
			        'STI - PMO | Matriz de Riscos'[Prazo para Resolução] <> BLANK(),
			        USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Prazo para Resolução])
			        )+0
			    
			    VAR ANTECIPADOS = 
			    CALCULATE(
			       DISTINCTCOUNT('STI - PMO | Matriz de Riscos'[ID]),
			        /*USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),*/
			        //'STI - PMO | Matriz de Riscos'[Data da Resolução] <> BLANK(),
			        USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),
			         MONTH('STI - PMO | Matriz de Riscos'[Prazo para Resolução]) > MONTH('STI - PMO | Matriz de Riscos'[Data da Resolução])
			        )
			
			    VAR geral = prazo + ANTECIPADOS
			
			    VAR fora = 
			    CALCULATE(
			       DISTINCTCOUNT('STI - PMO | Matriz de Riscos'[ID]),
			        /*USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),*/
			        'STI - PMO | Matriz de Riscos'[Data da Resolução] <> BLANK(),
			        USERELATIONSHIP(D_Calendar[Date],'STI - PMO | Matriz de Riscos'[Data da Resolução]),
			        MONTH('STI - PMO | Matriz de Riscos'[Data da Resolução]) <> MONTH('STI - PMO | Matriz de Riscos'[Prazo para Resolução]) 
			        )+0
			    RETURN
			    DIVIDE(fora,geral,0)
			```
		displayFolder: Matriz Risco - Lists
		lineageTag: 6ab93213-91ad-43f9-85bc-c38ea6359df8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

