	measure '4.3 vBarra Progresso StatuS Horizontal' = ```
			
			VAR vValor = SELECTEDVALUE('F_Asana_Unificado'[Status Name])
			VAR vStatus = SELECTEDVALUE('F_Asana_Unificado'[Project Current Status Color])
			
			-- Ícone correspondente
			VAR vMeta =
			    SWITCH(
			        TRUE(),
			        vStatus = "green",   "🟢",
			        vStatus = "red",     "🔴",
			        vStatus = "blue",    "🔵",
			        vStatus = "yellow",  "🟡",
			        vStatus = "complete","✅",
			        "⚫"
			    )
			
			-- FORMATAÇÕES
			VAR vFonte = "Segoe UI"
			VAR vRotulo_categoria_texto = "Status: "
			VAR vRotulo_categoria_cor = "#000000"
			VAR vRotulo_categoria_tam = 18
			VAR vRotulo_categoria_peso = "bold"   -- <<< Negrito no rótulo
			
			VAR vRotulo_dados_cor = "#000000"
			VAR vRotulo_dados_tam = 15
			VAR vRotulo_dados_peso = 150        -- <<< Normal no valor
			
			-- Layout
			VAR vComprimento_Layout = 300
			VAR vAltura_Layout = 30
			VAR vOffsetX = 90
			VAR vOffsetY = 10
			VAR vLargura = 100
			VAR vAltura = 30
			
			RETURN
			"data:image/svg+xml;utf8,<svg width='" & vComprimento_Layout & "' height='" & vAltura_Layout &
			"' viewBox='" & vOffsetX & " " & vOffsetY & " " & vLargura & " " & vAltura &
			"' xmlns='http://www.w3.org/2000/svg'>
			
			<text fill='" & vRotulo_categoria_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_categoria_tam & "' font-weight='" & vRotulo_categoria_peso & "'>
			    <tspan x='0' y='28'>" & vRotulo_categoria_texto & "</tspan>
			</text>
			
			<text fill='" & vRotulo_dados_cor & "' font-family='" & vFonte & "' font-size='" & vRotulo_dados_tam & "' font-weight='" & vRotulo_dados_peso & "'>
			    <tspan x='65' y='28'>" & vMeta & " " & vValor & "</tspan>
			</text>
			
			</svg>"
			
			```
		displayFolder: Tarefas
		lineageTag: 04611edb-d889-4631-b12e-b8772a29292f

	measure '5. Total Task Concluidas PMO' =
			
			/*Criado por: Tiago*/
			/*Aprovado por: */
			/*Revisado por: Massáro Júnio em 13/04/24*/
			    CALCULATE(
			        DISTINCTCOUNTNOBLANK('F_Tasks - Diário PMO'[Task Id]),
			            'F_Tasks - Diário PMO'[DT_Conclusão_Task] <> BLANK() &&
			            MONTH('F_Tasks - Diário PMO'[DT_Criação_Task]) = MONTH('F_Tasks - Diário PMO'[DT_Conclusão_Task])
			            )+0
		formatString: 0
		displayFolder: Tarefas PMO
		lineageTag: 3fdc51a0-811e-4efc-bf96-99e3d214fa26

