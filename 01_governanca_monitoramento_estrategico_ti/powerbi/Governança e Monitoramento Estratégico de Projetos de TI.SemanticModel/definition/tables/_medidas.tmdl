	measure 'Matriz - %TAP' = ```
			
			    VAR noprazo = CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Project Id]),'F_Asana_Unificado'[1 - TAP] = "Concluído")
			    VAR TAP = CALCULATE(DISTINCTCOUNTNOBLANK('F_Asana_Unificado'[Project Name]),ISBLANK('F_Asana_Unificado'[1 - TAP]) = FALSE(), 'F_Asana_Unificado'[1 - TAP] <> "Não Aplicável – Acompanhamento")
